[Unit]
Description=OpenCode WS relay bridge (CONNECT proxy over WebSocket relays, 127.0.0.1:18790)
After=network-online.target
Wants=network-online.target

[Service]
User=ocv2
Group=ocv2
Environment=RELAYS_FILE=/opt/opencode-v2/relays.json
Environment=PORT=18790
ExecStart=/usr/bin/node /opt/opencode-v2/multi-bridge.mjs
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
