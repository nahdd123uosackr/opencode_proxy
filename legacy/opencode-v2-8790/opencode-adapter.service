[Unit]
Description=OpenAI-compatible adapter for the OpenCode v2 server (127.0.0.1:8790)
After=opencode-v2.service
Requires=opencode-v2.service

[Service]
User=ocv2
Group=ocv2
WorkingDirectory=/var/lib/opencode-v2/work/adapter
EnvironmentFile=/etc/opencode-v2.client.env
EnvironmentFile=/etc/opencode-adapter.env
Environment=PORT=8790
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/opencode-v2/oc-adapter.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/opencode-v2
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
